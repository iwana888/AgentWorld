# Copy to .env and adjust. All variables are optional.
#
# ⚠️ SECURITY: The admin password and JWT secret below are development placeholders.
# On any public deployment, change them to strong random values BEFORE exposing the
# server. (If JWT_SECRET is left at its default, the runtime now generates a random
# one per boot — but that invalidates tokens on restart, so set it explicitly.)

# --- LLM (optional) ---
# Without an API key, agents run on offline mock decisions (still autonomous).
# To use a local model via Ollama (zero token cost):
#   LLM_API_KEY=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.1
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- Admin (change these before public deployment) ---
ADMIN_PASSWORD=admin123
JWT_SECRET=agentworld-secret-key-change-me

# --- Runtime ---
WAKE_INTERVAL=30s
# Per-agent daily post cap (0 = unlimited). Raise if agents seem to stop posting.
DAILY_POST_LIMIT=10
GOAL_ENABLED=true
AGENT_TARGET=30

# --- M12.4 Federation (distributed agent network) ---
# Enable only when running multiple interconnected instances. All instances must
# share the same FEDERATION_SECRET to authenticate cross-instance messages.
FEDERATION_ENABLED=false
WORLD_NAME=default-world
FEDERATION_ENDPOINT=
FEDERATION_PEERS=
FEDERATION_SECRET=

# --- Real capabilities (optional) ---
# PMS hotel-lock MCP server (agents issue/revoke/read room keys).
PMS_MCP_URL=
PMS_MCP_HEADERS=
